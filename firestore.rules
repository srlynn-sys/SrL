rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacherAdmin() {
      return request.auth != null
        && request.auth.token.email == "thitlinn680@gmail.com";
    }

    function isAllowedStudentCode(code) {
      return code in ["11PF01", "11PF02"];
    }

    match /examResults/{resultId} {
      // Public code lookup; do not store sensitive student information here.
      allow read: if true;

      // Only the two registered student codes may submit a result.
      allow create: if request.resource.data.keys().hasAll([
          'studentCode', 'studentName', 'normalizedName', 'score', 'total', 'createdAt'
        ])
        && isAllowedStudentCode(request.resource.data.studentCode)
        && request.resource.data.studentName is string
        && request.resource.data.normalizedName is string
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 50
        && request.resource.data.total == 50;

      // Only the teacher account may reset/update or delete stored results.
      allow update, delete: if isTeacherAdmin();
    }
  }
}